{
  "name": "nightowl-web",
  "private": true,
  "version": "0.1.31",
  "type": "module",
  "description": "夜猫看台 · 纯净观赛桌面版（本地单机）",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "electron:dev": "electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "migrate:data": "node tools/migrate-data.mjs",
    "sync:scores": "node tools/sync-scores.mjs",
    "sync:scores:apply": "node tools/sync-scores.mjs --apply",
    "build:espn-alias": "node tools/build-espn-alias.mjs",
    "verify:algo": "node spike/algo-baseline/run.mjs",
    "verify:findings": "node spike/algo-baseline/findings.mjs",
    "verify:calibrate": "node spike/algo-baseline/calibrate.mjs",
    "test:m3u8": "node tools/test-m3u8.mjs",
    "test:proxy": "node tools/test-proxy.mjs",
    "test:proxy-timeout": "node tools/test-proxy-timeout.mjs",
    "test:alias": "node tools/test-team-alias.mjs --offline",
    "test:alias:online": "node tools/test-team-alias.mjs",
    "test:online": "npm run test:alias:online && npm run test:sources && npm run check:scraper && npm run test:highlights:online && npm run check:live",
    "test:sync-outcome": "node tools/test-sync-outcome.mjs",
    "test:contrast": "node tools/check-contrast.mjs",
    "test:highlights": "node tools/test-highlights.mjs",
    "test:live": "node tools/test-live.mjs",
    "test:notifications": "node tools/test-notifications.mjs",
    "test:line-switch": "node tools/test-line-switch.mjs",
    "test:palette": "node tools/test-palette.mjs",
    "test:highlights:online": "node tools/check-highlights.mjs",
    "check:live": "node tools/check-live.mjs",
    "check:render": "electron tools/check-render.mjs",
    "test:sources": "node tools/check-sources.mjs",
    "test:playback": "node tools/test-playback.mjs",
    "test:media": "node tools/test-media.mjs",
    "test:stats": "node tools/test-stats.mjs",
    "test:standings": "node tools/test-standings.mjs",
    "check:scraper": "node tools/check-scraper.mjs",
    "test:scraper-match": "node tools/test-scraper-match.mjs",
    "test:session": "node tools/test-session.mjs",
    "test:scores": "node tools/test-scores.mjs",
    "test:owl": "node tools/test-owl.mjs",
    "test:tz": "node tools/test-tz.mjs",
    "test:scraper-parse": "node tools/test-scraper-parse.mjs",
    "test:all": "npm run verify:algo && npm run test:m3u8 && npm run test:proxy && npm run test:proxy-timeout && npm run test:playback && npm run test:media && npm run test:scraper-match && npm run test:scraper-parse && npm run test:session && npm run test:scores && npm run test:owl && npm run test:alias && npm run test:stats && npm run test:standings && npm run test:tz && npm run test:sync-outcome && npm run test:highlights && npm run test:live && npm run test:notifications && npm run test:line-switch && npm run test:palette && npm run test:contrast"
  },
  "dependencies": {
    "artplayer": "^5.4.0",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "virtua": "^0.51.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.nightowl.terrace",
    "productName": "NightOwl Terrace",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LuckyOneTwoThree",
        "repo": "nightowl-web"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "!server/cache/**",
      "!server/*.local.json",
      "src/core/**/*",
      "src/data/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NightOwl-Terrace-Setup-${version}.${ext}"
    }
  }
}
