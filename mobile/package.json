{
  "name": "nightowl-mobile",
  "version": "0.1.49",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "sync:shared": "node scripts/sync-shared.mjs",
    "verify:shared": "node scripts/verify-shared.mjs",
    "verify:pipeline": "node scripts/verify-pipeline.mjs",
    "sync:pipeline": "node scripts/verify-pipeline.mjs --write",
    "prestart": "npm run sync:shared && npm run sync:crests",
    "preexport:android": "npm run sync:shared && npm run sync:crests",
    "pretypecheck": "npm run sync:shared && npm run sync:crests && npm run verify:pipeline",
    "export:android": "expo export --platform android",
    "typecheck": "tsc --noEmit",
    "audit:touch": "node scripts/audit-touch.mjs",
    "check": "npm run verify:shared && npm run verify:pipeline && npm run audit:touch && npm run typecheck",
    "doctor": "expo-doctor",
    "eas:dev": "npx eas-cli@latest build --platform android --profile development",
    "eas:preview": "npx eas-cli@latest build --platform android --profile preview",
    "sync:crests": "node scripts/sync-crests.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-screen-orientation": "~58.0.4",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
